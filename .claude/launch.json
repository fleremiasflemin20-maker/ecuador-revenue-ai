{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "web"],
      "port": 8080
    },
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd api && source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8123"],
      "port": 8123
    }
  ]
}
